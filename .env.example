# Optional LLM-assisted extraction recovery.
ICSHPS_LLM_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
ICSHPS_LLM_EXTRACTION_MODEL=gpt-4o-mini
ICSHPS_LLM_EXTRACTION_MAX_TOKENS=1200

# Local project settings
ICSHPS_ENV=local
ICSHPS_RUNS_DIR=runs
ICSHPS_BUNDLES_DIR=data/hiring_bundles

# Optional V2 Google Calendar interview schedule suggestions.
# Suggestions use FreeBusy and always require human confirmation.
ICSHPS_INTERVIEW_PANEL_MEMBERS_JSON=
ICSHPS_GOOGLE_CALENDAR_CREDENTIALS_FILE=
ICSHPS_INTERVIEW_TIMEZONE=Europe/Belgrade
ICSHPS_INTERVIEW_DURATION_MINUTES=45
ICSHPS_INTERVIEW_SEARCH_WORKDAYS=10
ICSHPS_INTERVIEW_WORKDAY_START=10:00
ICSHPS_INTERVIEW_WORKDAY_END=17:00
